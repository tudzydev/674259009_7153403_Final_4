# Copy to .env.local for local development. No secrets belong here.
# Origin only: do not append /api/events. Rebuild after changing this value.
BACKEND_API_URL=http://localhost:4000

# Production on Vercel:
# BACKEND_API_URL=https://event-backend-5m5f.onrender.com

# Optional fallback, used only when BACKEND_API_URL is unset:
# NEXT_PUBLIC_API_URL=https://event-backend-5m5f.onrender.com

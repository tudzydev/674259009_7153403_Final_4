# Copy to .env.local, then replace database placeholders before starting.
PORT=4000
DATABASE_PROVIDER=local
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5433/event_db
DATABASE_CONNECT_TIMEOUT_MS=10000

# Exact spelling required by src/app.ts; comma-separated origins are supported.
FRONEND_URL=http://localhost:3000,https://674259009-7153403-final-d.vercel.app

# For Neon, copy this example to .env.neon and replace DATABASE_PROVIDER/URL:
# DATABASE_PROVIDER=neon
# DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_PROJECT.neon.tech/YOUR_DATABASE

# Optional trusted CA file; set before starting Bun if your network requires it.
# NODE_EXTRA_CA_CERTS=/absolute/path/to/trusted-ca.pem
